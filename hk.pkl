amends "package://github.com/jdx/hk/releases/download/v1.50.0/hk@1.50.0#/Config.pkl"

local jsGlob = List("*.js", "*.mjs", "*.jsx", "*.ts", "*.tsx")
local formatGlob = List("*.js", "*.mjs", "*.jsx", "*.ts", "*.tsx", "*.json", "*.md", "*.yml", "*.yaml")

local linters = new Mapping<String, Step> {
    ["eslint"] {
        glob = jsGlob
        stage = jsGlob
        check = "pnpm exec eslint {{files}}"
        fix = "pnpm exec eslint --fix {{files}}"
    }
    ["prettier"] {
        glob = formatGlob
        stage = formatGlob
        check = "pnpm exec prettier --check {{files}}"
        fix = "pnpm exec prettier --write {{files}}"
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    // hk gives post-merge no changed-file list (generic hook), so `glob` matches
    // nothing; diff ORIG_HEAD..HEAD in-command to gate installs on the touched file.
    ["post-merge"] {
        steps {
            ["pnpm-install"] {
                check = "if git diff --name-only ORIG_HEAD HEAD | grep -qx pnpm-lock.yaml; then pnpm install; fi"
            }
            ["mise-install"] {
                check = "if git diff --name-only ORIG_HEAD HEAD | grep -qxE '\\.?mise\\.toml'; then mise install; fi"
            }
        }
    }
}
